#!name = 大师兄影视 去弹窗
#!desc = 去掉三类弹窗：① 酷卡(kalert)推广弹窗 ② 置顶公告/通告弹窗 ③ 新版本更新弹窗。全部在请求/响应阶段直接改写，不阻塞连接，不白屏、不拖慢启动。
#!homepage = https://github.com/ding3700/dsxys-loon
#!author = ding3700
#!system = ios

[Script]
http-request ^https?://(ioskuka\.com|fk\.ioskuka\.com)/kalert/(config|status|event)[0-9]*\.(json|php) script-path=https://raw.githubusercontent.com/ding3700/dsxys-loon/main/dsx_kuka_block.js, requires-body=false, timeout=5, tag=酷卡推广弹窗
http-response ^https?://app2\.dsx\.ac/ndsx\.php/ script-path=https://raw.githubusercontent.com/ding3700/dsxys-loon/main/dsx_api_clean.js, requires-body=true, timeout=5, tag=公告与更新弹窗

[MITM]
hostname = %APPEND% ioskuka.com, fk.ioskuka.com, app2.dsx.ac
